#!/bin/bash
# Muestra la batería de los G PRO X para el widget del panel
b=$(headsetcontrol -b -o json 2>/dev/null | jq -r '.devices[0].battery // empty')
status=$(jq -r '.status // empty' <<<"$b" 2>/dev/null)
case "$status" in
  BATTERY_AVAILABLE) echo "🎧 $(jq -r '.level' <<<"$b")%" ;;
  BATTERY_CHARGING)  echo "🎧 ⚡" ;;
  *)                 echo "🎧 --" ;;
esac
